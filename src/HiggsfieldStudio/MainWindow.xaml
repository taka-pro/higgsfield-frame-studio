<Window x:Class="HiggsfieldStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Style="{StaticResource {x:Type Window}}" Title="Frame Studio — Higgsfield API" Width="1400" Height="940" MinWidth="1120" MinHeight="760" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
 <Grid Margin="26,20">
  <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="44"/></Grid.RowDefinitions>
  <Grid Grid.Row="0">
   <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="FRAME STUDIO" FontSize="26" FontWeight="Bold"/><Border Background="#DFEBDD" CornerRadius="4" Padding="9,3" Margin="14,3,0,4"><TextBlock x:Name="ModelBadge" Text="Wan 3.0" Foreground="#496B57" FontWeight="Bold" FontSize="12"/></Border></StackPanel><TextBlock Text="キャラと景色から、あなただけのワンシーン。  /  Higgsfield API" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><TextBlock x:Name="KeyStatus" Text="APIキー 未設定" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,14,0"/><Button Content="API設定" Click="Settings_Click"/></StackPanel>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="12" Grid.Column="0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel><TextBlock Text="01  キャラを選ぶ" FontWeight="Bold" FontSize="16" Margin="4,3,0,8"/><Button Content="＋ キャラ画像を追加" Click="AddImage_Click" Margin="0,0,0,8"/></StackPanel>
     <ListBox Grid.Row="1" x:Name="AssetList" SelectionChanged="AssetList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><StackPanel><Image Source="{Binding Thumbnail}" Height="90" Stretch="Uniform"/><TextBlock Text="{Binding Name}" FontSize="11" Margin="1,4,0,2"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
     <StackPanel Grid.Row="2"><TextBlock Text="02  背景を選ぶ" FontWeight="Bold" FontSize="16" Margin="4,12,0,8"/><Button Content="＋ 背景画像を追加" Click="Reference_Click" Margin="0,0,0,8"/></StackPanel>
     <ListBox Grid.Row="3" x:Name="BackgroundList" SelectionChanged="Background_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><StackPanel><Image Source="{Binding Thumbnail}" Height="90" Stretch="Uniform"/><TextBlock Text="{Binding Name}" FontSize="11" Margin="1,4,0,2"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    </Grid>
   </Border>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="170"/></Grid.RowDefinitions>
    <Border Background="#E7E8DF" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="16">
     <Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
      <TextBlock x:Name="PreviewTitle" Text="選んだ素材" Foreground="{StaticResource Muted}" FontSize="12"/>
      <Grid Grid.Row="1"><TextBlock x:Name="EmptyPreview" Text="左で人物と背景を選択してください" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="SourcePreview" Stretch="Uniform"/><MediaElement x:Name="VideoPreview" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" Visibility="Collapsed" MediaEnded="Video_MediaEnded" MediaFailed="Video_MediaFailed"/></Grid>
      <TextBlock Grid.Row="2" x:Name="PreviewDescription" Text="人物と背景を参照してワンシーンを生成します。" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" FontSize="12"/>
     </Grid>
    </Border>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,12"><Button Content="元画像" Click="ShowSource_Click" Margin="0,0,8,0"/><Button x:Name="PlayButton" Content="▶ 再生" Click="Play_Click" IsEnabled="False" Margin="0,0,8,0"/><Button Content="フォルダを開く" Click="OpenOutput_Click" Margin="8,0,0,0"/></StackPanel>
    <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="16" Padding="14"><DockPanel><Grid DockPanel.Dock="Top" Margin="0,0,0,8"><TextBlock Text="今回の生成履歴" FontWeight="Bold"/><Button x:Name="ResumeButton" Content="生成状態を確認" HorizontalAlignment="Right" FontSize="11" Padding="8,4" Click="Resume_Click"/></Grid><ListBox x:Name="HistoryList" DisplayMemberPath="Display" SelectionChanged="History_SelectionChanged" FontSize="12"/></DockPanel></Border>
   </Grid>
   <Border Grid.Column="4" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="20">
    <DockPanel>
     <StackPanel DockPanel.Dock="Bottom">
      <Button x:Name="GenerateButton" Content="動画を生成する" Background="{StaticResource Accent}" Foreground="#FFFFFF" BorderBrush="{StaticResource Accent}" FontWeight="Bold" IsEnabled="False" Click="Generate_Click" Padding="14,12"/>
      <Button x:Name="PauseButton" Content="状態確認を中断（生成は継続）" Visibility="Collapsed" Click="Pause_Click" Margin="0,8,0,0" FontSize="11"/>
      <TextBlock Text="画像は初回生成時にアップロード・以降再利用。&#10;生成ボタンを押すと残高を消費します。" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
     </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <TextBlock Text="03  動きをつける" FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
     <StackPanel x:Name="SettingsPanel">
      <TextBlock Text="動画モデル" Style="{StaticResource Caption}"/><ComboBox x:Name="ModelBox" SelectionChanged="Model_Changed"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <TextBlock x:Name="ModelHint" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,12"/>
      <TextBlock Text="ポーズ・アクション" Style="{StaticResource Caption}"/><ComboBox x:Name="ActionBox" SelectionChanged="Options_Changed"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <Border Background="#EDF2E7" CornerRadius="6" Padding="10" Margin="0,10,0,0"><StackPanel><TextBlock x:Name="DefaultCommentLabel" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="DefaultComment" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
      <TextBlock x:Name="ArrangementLabel" Text="セリフアレンジ（任意）" Style="{StaticResource Caption}" Margin="0,10,0,6"/><TextBox x:Name="DialogueBox" Height="54" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="Input_Changed"/>
      <TextBlock x:Name="DialogueHint" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,12"/>
      <TextBlock Text="長さ（秒）" Style="{StaticResource Caption}"/><ComboBox x:Name="DurationBox" SelectionChanged="Options_Changed"/>
      <TextBlock x:Name="FixedSettingsLabel" Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
     </StackPanel>
    </StackPanel></ScrollViewer>
    </DockPanel>
   </Border>
  </Grid>
  <Expander Grid.Row="2" x:Name="ApiExpander" Header="APIの記録  ·  リクエスト / レスポンス（キー・URLは非表示）" Foreground="{StaticResource Muted}" Margin="0,14,0,0"><TextBox x:Name="TraceBox" IsReadOnly="True" Height="170" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Expander>
  <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="準備完了 · 素材と動きを選択してください" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}"/><ProgressBar x:Name="Progress" Grid.Column="1" Height="3" Foreground="{StaticResource Accent}" Background="#DDE5D8" Visibility="Collapsed" IsIndeterminate="True" VerticalAlignment="Center"/></Grid>
 </Grid>
</Window>
